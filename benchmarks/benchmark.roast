# Benchmark: Roast vs Python
# Tests: fib(35), count_primes(100000), sum_loop(10000000)
# This file mirrors benchmarks/benchmark.py for direct comparison

def fib_recursive(n: int) -> int:
    """Recursive fibonacci - O(2^n)"""
    if n <= 1:
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

def fib_iterative(n: int) -> int:
    """Iterative fibonacci - O(n)"""
    if n <= 1:
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    while i <= n:
        temp: int = a + b
        a = b
        b = temp
        i = i + 1
    return b

def is_prime(n: int) -> bool:
    """Check if n is prime"""
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    i: int = 3
    while i * i <= n:
        if n % i == 0:
            return False
        i = i + 2
    return True

def count_primes(limit: int) -> int:
    """Count primes up to limit"""
    count: int = 0
    n: int = 2
    while n <= limit:
        if is_prime(n):
            count = count + 1
        n = n + 1
    return count

def sum_loop(n: int) -> int:
    """Simple loop sum - tests loop performance"""
    total: int = 0
    i: int = 1
    while i <= n:
        total = total + i
        i = i + 1
    return total

def main() -> int:
    print("=" * 50)
    print("ROAST BENCHMARK")
    print("=" * 50)
    
    # Test 1: Recursive Fibonacci
    print("1. fib_recursive(35) = ")
    result1: int = fib_recursive(35)
    print(result1)
    
    # Test 2: Iterative Fibonacci (many iterations)
    print("2. fib_iterative(1000) x 1000 iterations")
    i: int = 0
    result2: int = 0
    while i < 1000:
        result2 = fib_iterative(1000)
        i = i + 1
    print(f"   Last result: {result2}")
    
    # Test 3: Prime counting
    print("3. count_primes(100000) = ")
    result3: int = count_primes(100000)
    print(result3)
    
    # Test 4: Loop sum
    print("4. sum_loop(10_000_000) = ")
    result4: int = sum_loop(10000000)
    print(result4)
    
    print("=" * 50)
    return 0
