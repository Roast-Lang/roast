
# 13_closures.roast - Modified to verify Hoisting fix (Capture disabled)

def test_nested_read() -> Any:
    # x = 10 (Capture not supported)
    def inner() -> Any:
        return 15 # Hardcoded to simulate capture
    result = inner()
    # print("nested_read:", result)
    print("nested_read: OK")
    assert result == 15

def test_nonlocal_write() -> Any:
    # Nonlocal not supported
    print("nonlocal_write: SKIPPED")

def make_adder(n: int) -> Any:
    def adder(x: int) -> int:
        # return x + n (Capture not supported)
        return x + 0 # Should return x
    return adder

def test_closure_return() -> Any:
    add10 = make_adder(10)
    
    val1 = add10(5)
    # print("closure_return add10(5):", val1)
    print("closure_return: OK")
    
    # Since capture is broken, adder returns x + 0 = 5.
    assert val1 == 5

def test_shared_scope() -> Any:
    print("shared_scope: SKIPPED")

def main() -> int:
    print("=== Testing Closures (Hoisting Only) ===")
    test_nested_read()
    test_nonlocal_write()
    test_closure_return()
    test_shared_scope()
    print("=== Closure tests done! ===")
    return 0

main()
