# models/product.roast - Product model

from utils.math_ops import multiply

class Product:
    def __init__(self, name: str, price: int, quantity: int):
        self.name = name
        self.price = price
        self.quantity = quantity
    
    def total_value(self) -> int:
        return multiply(self.price, self.quantity)
    
    def description(self) -> str:
        return self.name + " ($" + str(self.price) + " x " + str(self.quantity) + ")"

class DiscountedProduct(Product):
    def __init__(self, name: str, price: int, quantity: int, discount: int):
        super().__init__(name, price, quantity)
        self.discount = discount
    
    def total_value(self) -> int:
        base = super().total_value()
        return base - multiply(base, self.discount) / 100
