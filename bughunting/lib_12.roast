# Library file for import testing

def add(a: int, b: int) -> int:
    return a + b

def subtract(a: int, b: int) -> int:
    return a - b

class Calculator:
    value: int
    
    def __init__(self, start: int) -> None:
        self.value = start
    
    def add(self, n: int) -> None:
        self.value = self.value + n
    
    def get_value(self) -> int:
        return self.value
