# HTTP Client Module
# Provides async HTTP client for web requests

from typing import Optional, Dict, List
import asyncio

# ============================================================================
# HTTP Response
# ============================================================================

class Response:
    """HTTP Response object."""
    status_code: int
    body: str
    headers: Dict[str, str]
    url: str
    
    def __init__(self, status_code: int, body: str, url: str) -> None:
        self.status_code = status_code
        self.body = body
        self.url = url
        self.headers = {}
    
    def is_success(self) -> bool:
        """Check if response is successful (2xx)."""
        return self.status_code >= 200 and self.status_code < 300
    
    def json(self) -> Dict[str, str]:
        """Parse response as JSON (simplified)."""
        # Simplified JSON parsing
        return {"raw": self.body}


# ============================================================================
# HTTP Client
# ============================================================================

class HttpClient:
    """Async HTTP client for making web requests."""
    timeout: int
    max_retries: int
    user_agent: str
    
    def __init__(self, timeout: int = 30, max_retries: int = 3) -> None:
        self.timeout = timeout
        self.max_retries = max_retries
        self.user_agent = "RoastScraper/1.0"
    
    async def get(self, url: str) -> Response:
        """Perform async GET request."""
        print(f"[HTTP] GET {url}")
        
        # Simulate network delay (async)
        await asyncio.sleep(0.1)
        
        # Mock responses based on URL
        if "example.com" in url:
            body = "<html><head><title>Example</title></head><body><h1>Example Domain</h1></body></html>"
            return Response(200, body, url)
        elif "api.github.com" in url:
            body = '{"login": "roast-lang", "repos": 42}'
            return Response(200, body, url)
        elif "error" in url:
            return Response(500, "Internal Server Error", url)
        else:
            body = f"<html><body>Content from {url}</body></html>"
            return Response(200, body, url)
    
    async def post(self, url: str, data: str) -> Response:
        """Perform async POST request."""
        print(f"[HTTP] POST {url} (data: {len(data)} bytes)")
        await asyncio.sleep(0.1)
        return Response(201, '{"success": true}', url)


# ============================================================================
# Batch Fetcher (Multi-threaded)
# ============================================================================

async def fetch_all(urls: List[str], client: HttpClient) -> List[Response]:
    """Fetch multiple URLs concurrently."""
    print(f"[HTTP] Fetching {len(urls)} URLs concurrently...")
    
    results: List[Response] = []
    for url in urls:
        response: Response = await client.get(url)
        results.append(response)
    
    return results


# Module exports
def create_client(timeout: int = 30) -> HttpClient:
    """Factory function to create HTTP client."""
    return HttpClient(timeout=timeout)
