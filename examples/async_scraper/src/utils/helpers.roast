# Utilities Module
# Common helper functions

from typing import List

# ============================================================================
# String Utilities
# ============================================================================

def truncate(text: str, max_len: int) -> str:
    """Truncate text to max length with ellipsis."""
    if len(text) <= max_len:
        return text
    return text[:max_len] + "..."


def clean_whitespace(text: str) -> str:
    """Remove extra whitespace from text."""
    return text.strip()


def split_lines(text: str) -> List[str]:
    """Split text into lines."""
    return text.split("\n")


# ============================================================================
# URL Utilities
# ============================================================================

def is_valid_url(url: str) -> bool:
    """Check if URL is valid (simplified)."""
    return url.startswith("http://") or url.startswith("https://")


def get_domain(url: str) -> str:
    """Extract domain from URL."""
    if "://" in url:
        start: int = url.find("://") + 3
        end: int = url.find("/", start)
        if end == -1:
            return url[start:]
        return url[start:end]
    return url


def join_url(base: str, path: str) -> str:
    """Join base URL with path."""
    if base.endswith("/"):
        base = base[:-1]
    if not path.startswith("/"):
        path = "/" + path
    return base + path


# ============================================================================
# Logging Utilities
# ============================================================================

class Logger:
    """Simple logger."""
    name: str
    verbose: bool
    
    def __init__(self, name: str, verbose: bool = True) -> None:
        self.name = name
        self.verbose = verbose
    
    def info(self, message: str) -> None:
        """Log info message."""
        if self.verbose:
            print(f"[{self.name}] INFO: {message}")
    
    def error(self, message: str) -> None:
        """Log error message."""
        print(f"[{self.name}] ERROR: {message}")
    
    def debug(self, message: str) -> None:
        """Log debug message."""
        if self.verbose:
            print(f"[{self.name}] DEBUG: {message}")


def create_logger(name: str) -> Logger:
    """Create a logger instance."""
    return Logger(name=name, verbose=True)


# ============================================================================
# Timer Utilities
# ============================================================================

class Timer:
    """Simple timer for measuring execution time."""
    name: str
    started: bool
    
    def __init__(self, name: str) -> None:
        self.name = name
        self.started = False
    
    def start(self) -> None:
        """Start the timer."""
        self.started = True
        print(f"[Timer:{self.name}] Started")
    
    def stop(self) -> None:
        """Stop the timer."""
        if self.started:
            self.started = False
            print(f"[Timer:{self.name}] Stopped")


def create_timer(name: str) -> Timer:
    """Create a timer instance."""
    return Timer(name=name)
