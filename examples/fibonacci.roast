# Fibonacci sequence in Roast
# Demonstrates functions, type annotations, and recursion

def fibonacci_recursive(n: int) -> int:
    """Calculate the nth Fibonacci number recursively."""
    if n <= 1:
        return n
    return fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2)

def main() -> int:
    # Test recursive fibonacci
    result: int = fibonacci_recursive(40)
    print(result)
    return 0
