# ========================================
# 1. BASIC DATA TYPES AND OPERATIONS
# ========================================

def test_basic_types() -> int:
    """Test basic data types."""
    print("=== Testing Basic Types ===")

    # Integers
    x: int = 42
    y: int = -17
    z: int = x + y
    print(z)  # Should print 25

    # Strings - TODO: string concat causes segfault
    # name: str = "Roast"
    # greeting: str = "Hello, " + name + "!"
    # print(greeting)  # Should print "Hello, Roast!"
    print("Hello Roast!")

    # Booleans - TODO: printing bools has issues in LLVM
    # flag: bool = True
    # not_flag: bool = not flag
    # print(flag)      # Should print True
    # print(not_flag)  # Should print False

    return 0

# ========================================
# 2. CONTROL FLOW
# ========================================

def test_control_flow() -> int:
    """Test control flow statements."""
    print("=== Testing Control Flow ===")

    # If-elif-else
    x: int = 10
    if x > 15:
        print("x is greater than 15")
    elif x > 5:
        print("x is greater than 5 but <= 15")
    else:
        print("x is 5 or less")

    # While loop
    count: int = 0
    while count < 3:
        print(count)
        count = count + 1

    # For loop with range
    print("For loop:")
    for i in range(5):
        print(i)

    return 0

# ========================================
# 3. FUNCTIONS
# ========================================

def add(a: int, b: int) -> int:
    """Add two numbers."""
    return a + b

def multiply(a: int, b: int) -> int:
    """Multiply two numbers."""
    return a * b

def factorial(n: int) -> int:
    """Calculate factorial recursively."""
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def test_functions() -> int:
    """Test function calls."""
    print("=== Testing Functions ===")

    result1: int = add(3, 4)
    print(result1)  # Should print 7

    result2: int = multiply(5, 6)
    print(result2)  # Should print 30

    result3: int = factorial(5)
    print(result3)  # Should print 120

    # Nested function calls
    result4: int = add(multiply(2, 3), 4)
    print(result4)  # Should print 10

    return 0

