# ========================================
# 6. DICTIONARIES
# ========================================

def test_dicts() -> int:
    """Test dictionary operations."""
    print("=== Testing Dictionaries ===")

    # Create a dictionary
    ages: dict = {"alice": 30, "bob": 25, "charlie": 35}

    # Access values
    print("Alice's age:")
    print(ages["alice"])

    # Check length
    print("Number of entries:")
    print(len(ages))

    return 0

# ========================================
# 7. PATTERN MATCHING
# ========================================

def describe_number(n: int) -> str:
    """Describe a number using pattern matching."""
    match n:
        case 0:
            return "zero"
        case 1:
            return "one"
        case 2:
            return "two"
        case _:
            return "many"

def test_pattern_matching() -> int:
    """Test pattern matching."""
    print("=== Testing Pattern Matching ===")

    print(describe_number(0))
    print(describe_number(1))
    print(describe_number(2))
    print(describe_number(42))

    return 0

# ========================================
# 8. FIBONACCI (PERFORMANCE TEST)
# ========================================

def fib(n: int) -> int:
    """Calculate fibonacci number."""
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

def test_fibonacci() -> int:
    """Test fibonacci calculation."""
    print("=== Testing Fibonacci ===")

    for i in range(10):
        print(fib(i))

    # Performance test
    print("fib(30):")
    result: int = fib(30)
    print(result)  # Should print 832040

    return 0

