# Test returning and iterating over a list

items_owner: dict[int, int] = {}
next_item_id: int = 1

def add_item(owner: int) -> int:
    global next_item_id
    item_id = next_item_id
    next_item_id = next_item_id + 1
    items_owner[item_id] = owner
    print(f"Added item {item_id} (owner={owner})")
    return item_id

def get_items_for_user(user_id: int) -> list[int]:
    print(f"Getting items for user {user_id}...")
    result: list[int] = []
    for iid in range(1, next_item_id):
        print(f"  Checking {iid}")
        if iid in items_owner:
            owner = items_owner[iid]
            print(f"    Owner = {owner}")
            if owner == user_id:
                print(f"    Adding to result")
                result.append(iid)
    print(f"Returning list with {len(result)} items")
    return result

def main() -> int:
    print("1. Adding items...")
    add_item(1)
    add_item(1) 
    add_item(2)
    
    print("")
    print("2. Getting items for user 1...")
    items = get_items_for_user(1)
    print(f"Got {len(items)} items")
    
    print("")
    print("3. Iterating over returned list...")
    for item_id in items:
        print(f"  Item: {item_id}")
    
    print("")
    print("4. Done!")
    return 0

main()
