# Test nested function calls with globals AND dicts

counter: int = 4
data: dict[int, int] = {}

def inner_func() -> list[int]:
    print(f"Inner: counter = {counter}")
    result: list[int] = []
    for i in range(1, counter):
        print(f"  i = {i}")
        if i in data:
            print(f"    i in data")
            result.append(i)
        else:
            print(f"    i not in data")
    print(f"Inner: returning list with {len(result)} items")
    return result

def outer_func() -> str:
    print("Outer: calling inner...")
    items = inner_func()
    print(f"Outer: got {len(items)} items")
    return "OK"

def main() -> int:
    print("Setup: adding to data dict...")
    data[1] = 100
    data[2] = 200
    # Note: 3 is NOT added
    
    print("")
    print("Main: calling outer...")
    result = outer_func()
    print(f"Main: result = {result}")
    return 0

main()
