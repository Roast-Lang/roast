# Test with function parameter comparison

counter: int = 4
data1: dict[int, str] = {}
data2: dict[int, int] = {}

def inner_func(user_id: int) -> list[int]:
    print(f"Inner: user_id = {user_id}, counter = {counter}")
    result: list[int] = []
    for i in range(1, counter):
        print(f"  i = {i}")
        if i in data2:
            print(f"    i in data2")
            val = data2[i]
            print(f"    data2[{i}] = {val}")
            if val == user_id:
                print(f"      val == user_id, appending")
                result.append(i)
            else:
                print(f"      val != user_id")
        else:
            print(f"    i not in data2")
    print(f"Inner: returning list with {len(result)} items")
    return result

def outer_func() -> str:
    print("Outer: calling inner(1)...")
    items = inner_func(1)
    print(f"Outer: got {len(items)} items")
    return "OK"

def main() -> int:
    print("Setup: adding to dicts...")
    data1[1] = "A"
    data1[2] = "B"
    data1[3] = "C"
    
    data2[1] = 1
    data2[2] = 1
    data2[3] = 2
    
    print("")
    print("Main: calling outer...")
    result = outer_func()
    print(f"Main: result = {result}")
    return 0

main()
