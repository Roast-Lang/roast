# Debug TCP server test

def main() -> int:
    print("1. Creating TCP server...")
    server = tcp_server_create("0.0.0.0", 9999)
    print("2. Server handle: " + str(server))
    
    if server < 0:
        print("Failed to create server")
        return 1
    
    print("3. Waiting for connection...")
    client = tcp_server_accept(server)
    print("4. Client handle: " + str(client))
    
    if client < 0:
        print("Failed to accept client")
        tcp_server_close(server)
        return 1
    
    print("5. Reading from client...")
    data = tcp_client_read(client, 4096)
    print("6. Read complete, len=" + str(len(data)))
    
    # Try to parse - this is where the crash might be
    print("7. Checking if data is empty...")
    if data == "":
        print("8a. Data is empty")
    else:
        print("8b. Data has content: " + str(len(data)) + " bytes")
        # Print first line
        first_line = ""
        for c in data:
            if c == "\n" or c == "\r":
                break
            first_line = first_line + c
        print("First line: " + first_line)
    
    print("9. Sending response...")
    response = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK"
    written = tcp_client_write(client, response)
    print("10. Wrote bytes: " + str(written))
    
    print("11. Closing client...")
    tcp_client_close(client)
    
    print("12. Closing server...")
    tcp_server_close(server)
    
    print("13. Done!")
    return 0

main()
