# Complex Test Project - Collection utilities
# Tests: list/dict operations, comprehensions, higher-order functions

def sum_list(numbers: list[int]) -> int:
    total: int = 0
    for n in numbers:
        total = total + n
    return total

def product_list(numbers: list[int]) -> int:
    result: int = 1
    for n in numbers:
        result = result * n
    return result

def find_min(numbers: list[int]) -> int:
    if len(numbers) == 0:
        return 0
    min_val: int = numbers[0]
    for n in numbers:
        if n < min_val:
            min_val = n
    return min_val

def find_max(numbers: list[int]) -> int:
    if len(numbers) == 0:
        return 0
    max_val: int = numbers[0]
    for n in numbers:
        if n > max_val:
            max_val = n
    return max_val

def filter_positive(numbers: list[int]) -> list[int]:
    return [n for n in numbers if n > 0]

def filter_negative(numbers: list[int]) -> list[int]:
    return [n for n in numbers if n < 0]

def filter_even(numbers: list[int]) -> list[int]:
    return [n for n in numbers if n % 2 == 0]

def filter_odd(numbers: list[int]) -> list[int]:
    return [n for n in numbers if n % 2 != 0]

def double_all(numbers: list[int]) -> list[int]:
    return [n * 2 for n in numbers]

def square_all(numbers: list[int]) -> list[int]:
    return [n * n for n in numbers]

def reverse_list(items: list[int]) -> list[int]:
    result: list[int] = []
    i: int = len(items) - 1
    while i >= 0:
        result.append(items[i])
        i = i - 1
    return result

def contains(items: list[int], target: int) -> bool:
    for item in items:
        if item == target:
            return True
    return False

def count_occurrences(items: list[int], target: int) -> int:
    count: int = 0
    for item in items:
        if item == target:
            count = count + 1
    return count

def unique(items: list[int]) -> list[int]:
    """Remove duplicates (preserving order)"""
    result: list[int] = []
    for item in items:
        if item not in result:
            result.append(item)
    return result

def flatten(nested: list[list[int]]) -> list[int]:
    """Flatten a 2D list to 1D"""
    result: list[int] = []
    for inner in nested:
        for item in inner:
            result.append(item)
    return result

def zip_lists(a: list[int], b: list[int]) -> list[list[int]]:
    """Zip two lists into pairs"""
    result: list[list[int]] = []
    min_len: int = len(a) if len(a) < len(b) else len(b)
    i: int = 0
    while i < min_len:
        pair: list[int] = [a[i], b[i]]
        result.append(pair)
        i = i + 1
    return result

def merge_sorted(a: list[int], b: list[int]) -> list[int]:
    """Merge two sorted lists into one sorted list"""
    result: list[int] = []
    i: int = 0
    j: int = 0
    while i < len(a) and j < len(b):
        if a[i] <= b[j]:
            result.append(a[i])
            i = i + 1
        else:
            result.append(b[j])
            j = j + 1
    while i < len(a):
        result.append(a[i])
        i = i + 1
    while j < len(b):
        result.append(b[j])
        j = j + 1
    return result
