# ==============================================================================
# Module: math_utils - Mathematical utilities
# ==============================================================================

def add(a: int, b: int) -> int:
    return a + b

def subtract(a: int, b: int) -> int:
    return a - b

def multiply(a: int, b: int) -> int:
    return a * b

def divide(a: int, b: int) -> int:
    if b == 0:
        return 0
    return a // b

def power(base: int, exp: int) -> int:
    """Calculate base^exp using iteration"""
    result: int = 1
    i: int = 0
    while i < exp:
        result = result * base
        i = i + 1
    return result

def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def gcd(a: int, b: int) -> int:
    """Greatest common divisor using Euclidean algorithm"""
    while b != 0:
        temp: int = b
        b = a % b
        a = temp
    return a

def is_even(n: int) -> bool:
    return n % 2 == 0

def is_odd(n: int) -> bool:
    return not is_even(n)

def abs_val(n: int) -> int:
    if n < 0:
        return -n
    return n

def clamp(value: int, min_val: int, max_val: int) -> int:
    if value < min_val:
        return min_val
    if value > max_val:
        return max_val
    return value

def sum_range(start: int, end: int) -> int:
    """Sum all integers from start to end (exclusive)"""
    total: int = 0
    i: int = start
    while i < end:
        total = total + i
        i = i + 1
    return total
