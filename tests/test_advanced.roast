# Test advanced string methods

def test_string_methods():
    print("=== String Methods ===")

    # split
    s: str = "hello,world,foo"
    # parts = s.split(",")  # TODO: test this

    # replace
    replaced: str = "hello world".replace("world", "roast")
    print(replaced)

    # startswith / endswith
    starts: bool = "hello".startswith("hel")
    print(starts)

    ends: bool = "hello".endswith("lo")
    print(ends)

    # lstrip / rstrip
    left: str = "   hello".lstrip()
    print(left)

    right: str = "hello   ".rstrip()
    print(right)

def test_list_methods():
    print("=== List Methods ===")

    nums: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]

    # count
    cnt: int = nums.count(1)
    print(cnt)  # Should be 2

    # index
    idx: int = nums.index(4)
    print(idx)  # Should be 2

    # reverse
    nums.reverse()
    print(nums[0])  # Should be 6 (was last)

    # clear
    nums2: list[int] = [1, 2, 3]
    nums2.clear()
    print(len(nums2))  # Should be 0

def main():
    test_string_methods()
    test_list_methods()

main()
