# Async/await tests

import asyncio

# Basic async function
async def hello() -> str:
    return "Hello, async!"

async def test_basic_async():
    result = await hello()
    assert result == "Hello, async!"

# Async with sleep
async def delayed_value(delay: float, value: int) -> int:
    await asyncio.sleep(delay)
    return value

async def test_async_sleep():
    result = await delayed_value(0.1, 42)
    assert result == 42

# Concurrent execution with gather
async def fetch_data(id: int) -> dict:
    await asyncio.sleep(0.1)  # Simulate network delay
    return {"id": id, "data": f"result_{id}"}

async def test_gather():
    results = await asyncio.gather(
        fetch_data(1),
        fetch_data(2),
        fetch_data(3)
    )
    
    assert len(results) == 3
    assert results[0]["id"] == 1
    assert results[1]["id"] == 2
    assert results[2]["id"] == 3

# Async generator
async def async_range(n: int) -> AsyncGenerator[int]:
    for i in range(n):
        await asyncio.sleep(0.01)
        yield i

async def test_async_generator():
    results: list[int] = []
    async for i in async_range(5):
        results.append(i)
    
    assert results == [0, 1, 2, 3, 4]

# Async context manager
class AsyncResource:
    name: str
    opened: bool = False
    
    def __init__(self, name: str) -> None:
        self.name = name
    
    async def __aenter__(self) -> AsyncResource:
        await asyncio.sleep(0.01)  # Simulate async open
        self.opened = True
        return self
    
    async def __aexit__(self, exc_type, exc_val, exc_tb) -> None:
        await asyncio.sleep(0.01)  # Simulate async close
        self.opened = False

async def test_async_context_manager():
    async with AsyncResource("test") as res:
        assert res.opened
        assert res.name == "test"
    
    assert not res.opened

# Task creation and cancellation
async def long_running_task() -> int:
    total: int = 0
    for i in range(10):
        await asyncio.sleep(0.1)
        total += i
    return total

async def test_task_creation():
    task = asyncio.create_task(long_running_task())
    
    # Let it run briefly
    await asyncio.sleep(0.25)
    
    # Cancel it
    task.cancel()
    
    try:
        await task
    except asyncio.CancelledError:
        pass  # Expected

# Timeouts
async def slow_operation() -> str:
    await asyncio.sleep(10.0)  # Very slow
    return "done"

async def test_timeout():
    try:
        await asyncio.wait_for(slow_operation(), timeout=0.1)
        assert False, "Should have timed out"
    except asyncio.TimeoutError:
        pass  # Expected

# Async locks
async def increment_with_lock(counter: dict, lock: asyncio.Lock) -> None:
    async with lock:
        current = counter["value"]
        await asyncio.sleep(0.01)  # Simulate work
        counter["value"] = current + 1

async def test_async_lock():
    counter: dict = {"value": 0}
    lock = asyncio.Lock()
    
    # Run multiple concurrent increments
    await asyncio.gather(*[
        increment_with_lock(counter, lock)
        for _ in range(10)
    ])
    
    assert counter["value"] == 10

# Async queue
async def producer(queue: asyncio.Queue, n: int) -> None:
    for i in range(n):
        await queue.put(i)
        await asyncio.sleep(0.01)
    await queue.put(None)  # Sentinel

async def consumer(queue: asyncio.Queue) -> list[int]:
    results: list[int] = []
    while True:
        item = await queue.get()
        if item is None:
            break
        results.append(item)
    return results

async def test_async_queue():
    queue: asyncio.Queue[int | None] = asyncio.Queue()
    
    # Run producer and consumer concurrently
    producer_task = asyncio.create_task(producer(queue, 5))
    consumer_task = asyncio.create_task(consumer(queue))
    
    await producer_task
    results = await consumer_task
    
    assert results == [0, 1, 2, 3, 4]

# Semaphore for limiting concurrency
async def limited_operation(sem: asyncio.Semaphore, id: int) -> int:
    async with sem:
        await asyncio.sleep(0.05)
        return id

async def test_semaphore():
    sem = asyncio.Semaphore(2)  # Max 2 concurrent
    
    # Run 5 operations with limited concurrency
    results = await asyncio.gather(*[
        limited_operation(sem, i)
        for i in range(5)
    ])
    
    assert sorted(results) == [0, 1, 2, 3, 4]

# Event for signaling
async def waiter(event: asyncio.Event, name: str) -> str:
    await event.wait()
    return f"{name} done"

async def test_event():
    event = asyncio.Event()
    
    # Create waiters
    task1 = asyncio.create_task(waiter(event, "A"))
    task2 = asyncio.create_task(waiter(event, "B"))
    
    # Let tasks start waiting
    await asyncio.sleep(0.05)
    
    # Signal all waiters
    event.set()
    
    results = await asyncio.gather(task1, task2)
    assert "A done" in results
    assert "B done" in results

# Main test runner
async def main() -> None:
    await test_basic_async()
    await test_async_sleep()
    await test_gather()
    await test_async_generator()
    await test_async_context_manager()
    await test_task_creation()
    await test_timeout()
    await test_async_lock()
    await test_async_queue()
    await test_semaphore()
    await test_event()
    print("All async tests passed!")

if __name__ == "__main__":
    asyncio.run(main())

