# Basic language feature tests

# Test variables and types
def test_variables():
    x: int = 42
    y: float = 3.14
    s: str = "hello"
    b: bool = True
    n: None = None
    
    assert x == 42
    assert y > 3.0
    assert s == "hello"
    assert b == True
    assert n is None

# Test arithmetic operations
def test_arithmetic():
    assert 2 + 3 == 5
    assert 10 - 4 == 6
    assert 3 * 4 == 12
    assert 15 / 3 == 5.0
    assert 17 // 5 == 3
    assert 17 % 5 == 2
    assert 2 ** 10 == 1024
    
    # Compound assignment
    x: int = 10
    x += 5
    assert x == 15
    x *= 2
    assert x == 30

# Test comparison operators
def test_comparisons():
    assert 5 > 3
    assert 3 < 5
    assert 5 >= 5
    assert 5 <= 5
    assert 5 == 5
    assert 5 != 3
    
    # Chained comparisons
    x: int = 5
    assert 1 < x < 10
    assert 0 <= x <= 10

# Test logical operators
def test_logical():
    assert True and True
    assert not False
    assert True or False
    assert not (False and True)

# Test strings
def test_strings():
    s: str = "Hello, World!"
    assert len(s) == 13
    assert s[0] == "H"
    assert s[-1] == "!"
    # assert s[0:5] == "Hello"  # Slice not yet supported
    assert "World" in s
    
    # String methods
    assert s.lower() == "hello, world!"
    assert s.upper() == "HELLO, WORLD!"
    assert "  test  ".strip() == "test"
    # TODO: List equality not yet implemented
    # assert "a,b,c".split(",") == ["a", "b", "c"]
    # assert "-".join(["a", "b", "c"]) == "a-b-c"

# Test f-strings
def test_fstrings():
    name: str = "World"
    num: int = 42
    assert f"Hello, {name}!" == "Hello, World!"
    assert f"The answer is {num}" == "The answer is 42"
    assert f"{num * 2}" == "84"

# Test lists
def test_lists():
    nums: list[int] = [1, 2, 3, 4, 5]
    assert len(nums) == 5
    assert nums[0] == 1
    assert nums[-1] == 5
    # assert nums[1:3] == [2, 3]  # Slice not yet supported
    
    # List methods
    nums.append(6)
    # TODO: List equality not yet implemented
    # assert nums == [1, 2, 3, 4, 5, 6]
    assert len(nums) == 6
    
    nums.pop()
    # assert nums == [1, 2, 3, 4, 5]
    assert len(nums) == 5
    
    assert sum(nums) == 15
    assert min(nums) == 1
    assert max(nums) == 5

# Test list comprehensions
def test_list_comprehension():
    squares: list[int] = [x ** 2 for x in range(5)]
    # TODO: List equality not yet implemented
    # assert squares == [0, 1, 4, 9, 16]
    assert len(squares) == 5
    
    evens: list[int] = [x for x in range(10) if x % 2 == 0]
    # assert evens == [0, 2, 4, 6, 8]
    assert len(evens) == 5

# Test dictionaries
def test_dicts():
    person: dict[str, str] = {
        "name": "Alice",
        "city": "Unknown"
    }
    
    assert person["name"] == "Alice"
    # assert person.get("age") == 30
    assert "name" in person
    assert len(person) == 2
    
    person["city"] = "NYC"
    assert person["city"] == "NYC"

# Test tuples
def test_tuples():
    point: tuple[int, int] = (3, 4)
    assert point[0] == 3
    assert point[1] == 4
    assert len(point) == 2
    
    # Tuple unpacking not yet supported
    # x, y = point
    # assert x == 3 and y == 4

# Test sets
def test_sets():
    nums: set[int] = {1, 2, 3, 3, 2, 1}
    assert len(nums) == 3
    assert 2 in nums
    assert 5 not in nums
    
    # Set intersection/union operators not yet supported
    # other: set[int] = {3, 4, 5}
    # assert nums & other == {3}
    # assert nums | other == {1, 2, 3, 4, 5}

# Entry point for tests
if __name__ == "__main__":
    test_variables()
    test_arithmetic()
    test_comparisons()
    test_logical()
    test_strings()
    test_fstrings()
    test_lists()
    test_list_comprehension()
    test_dicts()
    test_tuples()
    test_sets()
    print("All basic tests passed!")

