# Comprehensive Roast Language Test
# Tests: Types, f-strings, list comprehensions, try/except, classes

# ============================================
# Test 1: Basic Types and Arithmetic
# ============================================
def test_types():
    # Integer operations
    x: int = 10
    y: int = 3
    print(f"x = {x}, y = {y}")
    print(f"x + y = {x + y}")
    print(f"x - y = {x - y}")
    print(f"x * y = {x * y}")
    print(f"x // y = {x // y}")
    print(f"x % y = {x % y}")

# ============================================
# Test 2: String and F-string Operations
# ============================================
def test_strings():
    name: str = "Roast"
    version: int = 1
    print(f"Welcome to {name} v{version}!")

    # String repetition
    sep: str = "=" * 30
    print(sep)

    # Multiple interpolations
    x: int = 42
    y: int = 100
    print(f"Values: x={x}, y={y}, sum={x + y}")

# ============================================
# Test 3: Lists and Comprehensions
# ============================================
def test_lists():
    # Basic list
    numbers: list[int] = [1, 2, 3, 4, 5]
    print(f"Numbers length: {len(numbers)}")

    # List append
    numbers.append(6)
    print(f"After append length: {len(numbers)}")

    # List comprehension - squares
    squares: list[int] = [x * x for x in range(1, 6)]
    print(f"Squares length: {len(squares)}")

    # List comprehension with filter
    evens: list[int] = [x for x in range(1, 11) if x % 2 == 0]
    print(f"Evens length: {len(evens)}")

# ============================================
# Test 4: Control Flow
# ============================================
def test_control_flow():
    # If/else
    x: int = 10
    if x > 5:
        print("x is greater than 5")
    else:
        print("x is not greater than 5")

    # For loop
    print("Counting:")
    for i in range(1, 4):
        print(f"  {i}")

# ============================================
# Test 5: Functions
# ============================================
def add(a: int, b: int) -> int:
    return a + b

def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def test_functions():
    print(f"add(3, 4) = {add(3, 4)}")
    print(f"factorial(5) = {factorial(5)}")

# ============================================
# Test 6: Classes
# ============================================
class Point:
    def __init__(self, x: int, y: int):
        self.x = x
        self.y = y

    def squared_distance(self) -> int:
        return self.x * self.x + self.y * self.y

    def to_string(self) -> str:
        return f"Point({self.x}, {self.y})"

def test_classes():
    p: Point = Point(3, 4)
    print(f"Point: {p.to_string()}")
    print(f"Squared distance: {p.squared_distance()}")

# ============================================
# Test 7: Try/Except (basic - no exceptions raised)
# ============================================
def test_try_except():
    result: int = 0
    try:
        result = 42
        print(f"Inside try: result = {result}")
    except:
        result = -1
        print("Exception caught!")
    print(f"After try/except: result = {result}")

# ============================================
# Main
# ============================================
def main():
    sep: str = "=" * 50
    print(sep)
    print("Roast Language Comprehensive Test")
    print(sep)
    print("")

    print("--- Test 1: Types ---")
    test_types()
    print("")

    print("--- Test 2: Strings ---")
    test_strings()
    print("")

    print("--- Test 3: Lists ---")
    test_lists()
    print("")

    print("--- Test 4: Control Flow ---")
    test_control_flow()
    print("")

    print("--- Test 5: Functions ---")
    test_functions()
    print("")

    print("--- Test 6: Classes ---")
    test_classes()
    print("")

    print("--- Test 7: Try/Except ---")
    test_try_except()
    print("")

    print(sep)
    print("All tests completed!")
    print(sep)

main()
