# Debug iterative fib to find the bug
def fib_debug(n: int) -> int:
    print("Starting fib with n:")
    print(n)
    if n <= 1:
        print("Returning n (base case)")
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    print("Initial a, b, i:")
    print(a)
    print(b)
    print(i)
    while i <= n:
        print("Loop iteration:")
        print(i)
        temp: int = a + b
        print("temp = a + b:")
        print(temp)
        a = b
        b = temp
        i = i + 1
    print("Final b:")
    print(b)
    return b

def main() -> int:
    result: int = fib_debug(5)
    print("Result:")
    print(result)
    return 0
