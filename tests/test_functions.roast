# Function and control flow tests

# Test basic function
def add(a: int, b: int) -> int:
    return a + b

def test_basic_function():
    assert add(2, 3) == 5
    assert add(-1, 1) == 0
    assert add(0, 0) == 0

# Test default arguments
def greet(name: str, greeting: str = "Hello") -> str:
    return f"{greeting}, {name}!"

def test_default_args():
    assert greet("World") == "Hello, World!"
    assert greet("World", "Hi") == "Hi, World!"

# Test recursion
def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def test_recursion():
    assert factorial(0) == 1
    assert factorial(1) == 1
    assert factorial(5) == 120
    assert factorial(10) == 3628800

# Test nested functions
def outer(x: int) -> int:
    def inner(y: int) -> int:
        return y * 2
    return inner(x) + 1

def test_nested_functions():
    assert outer(5) == 11
    assert outer(0) == 1

# Test if/elif/else
def classify_number(n: int) -> str:
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    else:
        return "positive"

def test_conditionals():
    assert classify_number(-5) == "negative"
    assert classify_number(0) == "zero"
    assert classify_number(5) == "positive"

# Test for loops
def test_for_loops():
    total: int = 0
    for i in range(5):
        total += i
    assert total == 10
    
    # For with break
    found: int = -1
    for i in range(10):
        if i == 5:
            found = i
            break
    assert found == 5

# Test while loops
def test_while_loops():
    count: int = 0
    while count < 5:
        count += 1
    assert count == 5
    
    # While with break
    n: int = 0
    while True:
        n += 1
        if n >= 10:
            break
    assert n == 10

def main():
    test_basic_function()
    test_default_args()
    test_recursion()
    test_nested_functions()
    test_conditionals()
    test_for_loops()
    test_while_loops()
    print("All function tests passed!")

# Entry point
if __name__ == "__main__":
    main()
