def test(a: int, b: int) -> int:
    print(f"Before loop: a={a}, b={b}")
    while b != 0:
        temp: int = b
        print(f"In loop: a={a}, b={b}, temp={temp}")
        break
    print(f"After loop: a={a}, b={b}")
    return a

def main() -> int:
    r: int = test(48, 18)
    print(f"result={r}")
    return 0
