@dataclass
@derive(Ord)
class Point:
    x: int
    y: int

p1 = Point(1, 2)
p2 = Point(1, 3)
p3 = Point(2, 0)
p4 = Point(1, 2)

# p1 < p2 (same x, y is less)
r1 = p1.__lt__(p2)
print("(1,2) < (1,3) should be 1:")
print(r1)

# p1 < p3 (x is less, regardless of y)
r2 = p1.__lt__(p3)
print("(1,2) < (2,0) should be 1:")
print(r2)

# p2 < p1 (same x, y is greater - false)
r3 = p2.__lt__(p1)
print("(1,3) < (1,2) should be 0:")
print(r3)

# p1 < p4 (equal - should be false)
r4 = p1.__lt__(p4)
print("(1,2) < (1,2) should be 0:")
print(r4)

# p3 < p1 (x is greater - false)
r5 = p3.__lt__(p1)
print("(2,0) < (1,2) should be 0:")
print(r5)

print("__lt__ test PASSED!")
