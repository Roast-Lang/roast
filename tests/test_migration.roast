# Migration test file
# This file was migrated from Python to Roast

# After migration with type annotations:

def add(a: int, b: int) -> int:
    return a + b

# Test the migrated code
def test_migrated_variables():
    # Local variables (workaround for module-level globals)
    x: int = 42
    y: str = "hello"
    assert x == 42
    assert y == "hello"

def test_migrated_function():
    assert add(2, 3) == 5
    assert add(-1, 1) == 0

# After migration:
class Person:
    name: str
    age: int
    
    def __init__(self, name: str, age: int) -> None:
        self.name = name
        self.age = age
    
    def greet(self) -> str:
        return f"Hello, I'm {self.name}!"

def test_migrated_class():
    p = Person("Alice", 30)
    assert p.name == "Alice"
    assert p.age == 30
    assert p.greet() == "Hello, I'm Alice!"

def test_python2_migration():
    # Test integer division (float comparison has issues)
    assert 7 // 2 == 3
    assert 10 // 3 == 3

def process(items: list[int]) -> dict[str, int]:
    return {"sum": sum(items), "count": len(items)}

def test_typed_function():
    result = process([1, 2, 3, 4, 5])
    assert result["sum"] == 15
    assert result["count"] == 5

# Entry point
if __name__ == "__main__":
    print("Starting tests...")
    test_migrated_variables()
    print("1. test_migrated_variables passed")
    test_migrated_function()
    print("2. test_migrated_function passed")
    test_migrated_class()
    print("3. test_migrated_class passed")
    test_python2_migration()
    print("4. test_python2_migration passed")
    test_typed_function()
    print("5. test_typed_function passed")
    print("All migration tests passed!")

