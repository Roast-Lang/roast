# Fibonacci test - larger number
# Iterative version: O(n) time complexity
def fib(n: int) -> bint:
    if n <= 1:
        return bint(n)
    a: bint = bint(0)
    b: bint = bint(1)
    i: int = 2
    while i <= n:
        temp: bint = a + b
        a = b
        b = temp
        i = i + 1
    return b

def main() -> int:
    result: bint = fib(90)
    print(result)
    return 0
