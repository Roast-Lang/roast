@dataclass
@derive(Ord)
class Point:
    x: int
    y: int

p1 = Point(1, 2)
p2 = Point(1, 3)
p3 = Point(2, 0)
p4 = Point(1, 2)

# __lt__ tests
print("Testing __lt__:")
print(p1.__lt__(p2))  # 1 (1,2) < (1,3)
print(p1.__lt__(p3))  # 1 (1,2) < (2,0)
print(p1.__lt__(p4))  # 0 (1,2) not < (1,2)
print(p2.__lt__(p1))  # 0 (1,3) not < (1,2)

# __le__ tests  
print("Testing __le__:")
print(p1.__le__(p2))  # 1 (1,2) <= (1,3)
print(p1.__le__(p4))  # 1 (1,2) <= (1,2) - equal case
print(p2.__le__(p1))  # 0 (1,3) not <= (1,2)

# __gt__ tests
print("Testing __gt__:")
print(p2.__gt__(p1))  # 1 (1,3) > (1,2)
print(p3.__gt__(p1))  # 1 (2,0) > (1,2)
print(p1.__gt__(p4))  # 0 (1,2) not > (1,2) - equal case
print(p1.__gt__(p2))  # 0 (1,2) not > (1,3)

# __ge__ tests
print("Testing __ge__:")
print(p2.__ge__(p1))  # 1 (1,3) >= (1,2)
print(p1.__ge__(p4))  # 1 (1,2) >= (1,2) - equal case
print(p1.__ge__(p2))  # 0 (1,2) not >= (1,3)

print("Ord test COMPLETE!")
