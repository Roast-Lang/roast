# Ownership and borrowing tests - simplified
# Uses basic ownership semantics that are supported

# Test copy types (primitive integers are copied)
def test_copy_types():
    x: int = 42
    y: int = x  # Copy, not move
    assert x == 42  # x is still valid
    assert y == 42

# Test string operations
def test_string_ownership():
    s: str = "hello"
    t: str = s  # Copy for strings
    assert s == "hello"
    assert t == "hello"

# Test list operations
def test_list_ownership():
    items: list[int] = [1, 2, 3]
    first = items[0]
    assert first == 1
    assert len(items) == 3

# Test function parameter passing
def process_value(x: int) -> int:
    return x * 2

def test_function_params():
    value: int = 10
    result = process_value(value)
    # value is still valid (copy semantics for int)
    assert value == 10
    assert result == 20

# Test class instance ownership
class Counter:
    value: int
    
    def __init__(self) -> None:
        self.value = 0
    
    def increment(self) -> None:
        self.value = self.value + 1
    
    def get(self) -> int:
        return self.value

def test_class_ownership():
    c = Counter()
    c.increment()
    c.increment()
    assert c.get() == 2

# Entry point
if __name__ == "__main__":
    test_copy_types()
    print("1. test_copy_types passed")
    test_string_ownership()
    print("2. test_string_ownership passed")
    test_list_ownership()
    print("3. test_list_ownership passed")
    test_function_params()
    print("4. test_function_params passed")
    test_class_ownership()
    print("5. test_class_ownership passed")
    print("All ownership tests passed!")
