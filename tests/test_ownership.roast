# Ownership and borrowing tests

# Test basic ownership
def test_ownership():
    x: owned str = "hello"
    y: str = x  # Move
    # x is no longer valid here
    assert y == "hello"

# Test borrowing (immutable reference)
def print_length(s: &str) -> int:
    # s is borrowed, not owned
    return len(s)

def test_borrow():
    message: str = "Hello, World!"
    length = print_length(&message)
    # message is still valid after borrowing
    assert length == 13
    assert message == "Hello, World!"

# Test mutable borrowing
def append_exclaim(s: &mut str) -> None:
    s += "!"

def test_mut_borrow():
    message: str = "Hello"
    append_exclaim(&mut message)
    assert message == "Hello!"

# Test copy types
def test_copy_types():
    x: int = 42
    y: int = x  # Copy, not move
    assert x == 42  # x is still valid
    assert y == 42

# Test ownership in functions
def take_ownership(s: owned str) -> str:
    return s.upper()

def test_ownership_transfer():
    message: owned str = "hello"
    result = take_ownership(message)
    # message is no longer valid
    assert result == "HELLO"

# Test clone for owned types
def test_clone():
    original: str = "hello"
    cloned: str = original.clone()
    assert original == cloned
    assert original == "hello"  # Both are valid

# Test ownership with containers
def test_container_ownership():
    items: owned list[str] = ["a", "b", "c"]
    first: str = items[0].clone()  # Clone to keep items valid
    assert first == "a"
    assert len(items) == 3

# Test reference counting
def test_refcount():
    data: rc[list[int]] = rc([1, 2, 3, 4, 5])
    ref1 = data
    ref2 = data
    # All references point to same data
    assert ref1 == ref2
    assert sum(data) == 15

# Test lifetime annotations (conceptual)
def longest[T](a: &T, b: &T) -> &T:
    """Return reference to longer item."""
    if len(a) > len(b):
        return a
    return b

def test_lifetimes():
    s1: str = "short"
    s2: str = "much longer string"
    result = longest(&s1, &s2)
    assert result == "much longer string"

# Test struct ownership
class Buffer:
    data: owned list[int]
    
    def __init__(self, data: owned list[int]) -> None:
        self.data = data
    
    def take_data(self) -> owned list[int]:
        """Move data out of buffer."""
        return self.data  # Move

def test_struct_ownership():
    buf = Buffer([1, 2, 3])
    data = buf.take_data()
    assert data == [1, 2, 3]
    # buf.data is no longer valid

# Test drop semantics
class Resource:
    name: str
    closed: bool = False
    
    def __init__(self, name: str) -> None:
        self.name = name
        print(f"Resource {name} opened")
    
    def __drop__(self) -> None:
        self.closed = True
        print(f"Resource {self.name} closed")

def test_drop():
    def use_resource() -> None:
        res = Resource("test")
        # res is dropped at end of scope
    
    use_resource()
    # Resource should be dropped now

# Test move semantics with match
def process_option(opt: Option[str]) -> str:
    match opt:
        case Some(value):
            return f"Got: {value}"
        case None:
            return "Nothing"

def test_match_move():
    some_val: Option[str] = Some("hello")
    result = process_option(some_val)
    # some_val is moved into match
    assert result == "Got: hello"

# Entry point
if __name__ == "__main__":
    test_ownership()
    test_borrow()
    test_mut_borrow()
    test_copy_types()
    test_ownership_transfer()
    test_clone()
    test_container_ownership()
    # test_refcount()  # Requires rc type
    test_lifetimes()
    # test_struct_ownership()  # Requires full ownership
    test_drop()
    print("All ownership tests passed!")

