# Python compatibility tests

# Test importing Python modules
import json
import math
import os
import sys
import collections
import itertools
import functools
import typing

# Test math module
def test_math():
    assert math.pi > 3.14 and math.pi < 3.15
    assert math.e > 2.71 and math.e < 2.72
    assert math.sqrt(4.0) == 2.0
    assert math.sqrt(9.0) == 3.0
    assert abs(math.sin(0.0)) < 0.001
    assert abs(math.cos(0.0) - 1.0) < 0.001
    assert math.floor(3.7) == 3
    assert math.ceil(3.2) == 4
    assert math.abs(-5) == 5
    assert abs(math.pow(2.0, 3.0) - 8.0) < 0.001

# Test os module
def test_os():
    cwd = os.getcwd()
    assert len(cwd) > 0
    
    # getenv
    path = os.getenv("PATH")
    # PATH should exist
    
    # listdir
    files = os.listdir(".")
    assert isinstance(files, list)

# Test os.path module
from os import path as ospath

def test_os_path():
    assert ospath.exists(".")
    assert ospath.isdir(".")
    
    # join
    p = ospath.join("a", "b", "c")
    assert "a" in p and "b" in p
    
    # basename/dirname
    assert ospath.basename("/path/to/file.txt") == "file.txt"
    assert ospath.dirname("/path/to/file.txt") == "/path/to"
    
    # splitext
    base, ext = ospath.splitext("/path/to/file.txt")
    assert ext == ".txt"

