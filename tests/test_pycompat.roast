# Python compatibility tests - simplified
# Tests basic Python-compatible features

# Test basic math operations
def test_math():
    x: float = 3.14159
    y: float = 2.71828
    assert x > 3.0
    assert y > 2.7 and y < 2.8
    print("Math test passed")

# Test string operations
def test_strings():
    s: str = "hello world"
    assert len(s) == 11
    assert s.upper() == "HELLO WORLD"
    assert s.lower() == "hello world"
    print("String test passed")

# Test list operations  
def test_lists():
    items: list[int] = [1, 2, 3, 4, 5]
    assert len(items) == 5
    assert sum(items) == 15
    items.append(6)
    assert len(items) == 6
    print("List test passed")

# Test dict operations
def test_dicts():
    d: dict[str, int] = {"a": 1, "b": 2}
    assert d["a"] == 1
    d["c"] = 3
    assert len(d) == 3
    print("Dict test passed")

# Test class and methods
class Person:
    name: str
    age: int
    
    def __init__(self, name: str, age: int) -> None:
        self.name = name
        self.age = age
    
    def greet(self) -> str:
        return f"Hi, I'm {self.name}"

def test_classes():
    p = Person("Alice", 30)
    assert p.name == "Alice"
    assert p.age == 30
    assert p.greet() == "Hi, I'm Alice"
    print("Class test passed")

# Test control flow
def test_control_flow():
    # If/else
    x: int = 10
    result: str = ""
    if x > 5:
        result = "big"
    else:
        result = "small"
    assert result == "big"
    
    # While loop
    count: int = 0
    while count < 5:
        count = count + 1
    assert count == 5
    
    # For loop
    total: int = 0
    for i in range(5):
        total = total + i
    assert total == 10
    print("Control flow test passed")

# Test integer division
def test_division():
    assert 7 // 2 == 3
    assert 10 // 3 == 3
    assert 9 // 3 == 3
    print("Division test passed")

# Entry point
if __name__ == "__main__":
    test_math()
    test_strings()
    test_lists()
    test_dicts()
    test_classes()
    test_control_flow()
    test_division()
    print("All Python compatibility tests passed!")
