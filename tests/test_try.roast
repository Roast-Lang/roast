# Test exception handling with try/except
def might_fail(x: int) -> int:
    if x < 0:
        raise Exception("negative value")
    return x * 2

def process(x: int) -> int:
    result = might_fail(x)
    return result + 1

# Test with positive value
result = process(5)
print("Result:", result)
# 5 * 2 = 10, 10 + 1 = 11
assert result == 11
print("Try test PASSED!")
