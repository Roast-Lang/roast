# Type system tests

# Test basic type annotations
def test_basic_types():
    x: int = 42
    y: float = 3.14
    s: str = "hello"
    b: bool = True
    
    # Just test that values work
    assert x == 42
    assert s == "hello"
    assert b == True

# Test generic types with list
def first(items: list[int]) -> int:
    return items[0]

def test_generics():
    nums: list[int] = [1, 2, 3]
    assert first(nums) == 1

# Test typed class
class Config:
    def __init__(self, host: str, port: int, debug: bool = False) -> None:
        self.host = host
        self.port = port
        self.debug = debug

def test_typed_class():
    cfg = Config("localhost", 8080, True)
    assert cfg.host == "localhost"
    assert cfg.port == 8080
    assert cfg.debug == True

# Test tuple return values
def get_min_max(nums: list[int]) -> tuple[int, int]:
    return (min(nums), max(nums))

def test_tuple_type():
    nums: list[int] = [1, 2, 3, 4, 5]
    result = get_min_max(nums)
    assert result[0] == 1
    assert result[1] == 5

# Test literal types (simple control flow)
def get_status(code: int) -> str:
    if code == 0:
        return "ok"
    elif code < 0:
        return "error"
    else:
        return "pending"

def test_literal():
    assert get_status(0) == "ok"
    assert get_status(-1) == "error"
    assert get_status(1) == "pending"

# Test class methods
class File:
    def __init__(self, size: int) -> None:
        self._size = size
    
    def size(self) -> int:
        return self._size

def test_class_methods():
    file1 = File(100)
    file2 = File(200)
    
    assert file1.size() == 100
    assert file2.size() == 200

def main():
    test_basic_types()
    test_generics()
    test_typed_class()
    test_tuple_type()
    test_literal()
    test_class_methods()
    print("All type tests passed!")

# Entry point
if __name__ == "__main__":
    main()
